# Salin menjadi .env lalu isi nilainya:  cp .env.example .env
# File .env JANGAN di-commit ke GitHub.

# Port yang dibuka di mesin lokal (docker-compose.override.yml)
WEB_PORT=8080
# Port lokal 127.0.0.1 di VPS (docker-compose.vps.yml); pilih yang belum dipakai project lain
INVOICE_PORT=8085
APP_URL=http://localhost:8080
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# Kosongkan APP_KEY: akan dibuat otomatis dan disimpan di volume.
APP_KEY=

# ---- Database ----
# MODE A (default, laptop / server baru): MySQL ikut dibuat oleh Docker.
COMPOSE_PROFILES=bundled-db
DB_HOST=db
# MODE B (VPS dengan MySQL bersama): kosongkan COMPOSE_PROFILES, isi DB_HOST dan SHARED_DB_NETWORK, mis.
#   COMPOSE_PROFILES=
#   DB_HOST=ecommerce-db
#   SHARED_DB_NETWORK=belajarecomerce_ecommerce-network
SHARED_DB_NETWORK=

DB_PORT=3306
DB_DATABASE=nota
DB_USERNAME=nota
DB_PASSWORD=ganti-dengan-sandi-kuat
# Hanya untuk MODE A:
DB_ROOT_PASSWORD=ganti-dengan-sandi-root-kuat

# Akun pemilik toko (dibuat otomatis saat pertama kali jalan)
OWNER_NAME=Pemilik Toko
OWNER_EMAIL=
OWNER_PASSWORD=
