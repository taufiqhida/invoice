# Salin menjadi .env lalu isi nilainya:  cp .env.example .env
# File .env JANGAN di-commit ke GitHub.

# Port yang dibuka di mesin (VPS: pakai 80 bila tanpa reverse proxy lain)
WEB_PORT=8080
APP_URL=http://localhost:8080
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# Kosongkan APP_KEY: akan dibuat otomatis dan disimpan di volume.
APP_KEY=

# Database MySQL (container "db")
DB_DATABASE=nota
DB_USERNAME=nota
DB_PASSWORD=ganti-dengan-sandi-kuat
DB_ROOT_PASSWORD=ganti-dengan-sandi-root-kuat

# Akun pemilik toko (dibuat otomatis saat pertama kali jalan)
OWNER_NAME=Pemilik Toko
OWNER_EMAIL=
OWNER_PASSWORD=
